// Projexa Hub Central — data model
// PostgreSQL in every environment (e.g. Neon). DATABASE_URL comes from .env locally
// and from the hosting provider's environment variables in production (see README).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  /// Pooled connection, used by the app at runtime.
  url       = env("DATABASE_URL")
  /// Direct connection, used by `prisma db push` / migrations.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// An official department or team. Alumni and Campus Chapter are teams like any other
/// so they are always included in Analytics.
model Team {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default("")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  members     User[]
  invites     TeamInvite[]
  attendance  Attendance[]
  kpis        Kpi[]
  reports     WeeklyReport[]
  evaluations Evaluation[]
}

model User {
  id           String  @id @default(cuid())
  /// Sign-in identity: always <username>@projexahub.com for accounts created in Settings.
  email        String  @unique
  /// Null until the person accepts their invite and chooses a password.
  passwordHash String?
  /// The person's real inbox (Gmail etc.). Invite and password-reset links are sent here.
  contactEmail     String?   @unique
  /// Set once the person has proved they own contactEmail by clicking a link sent to it.
  emailVerifiedAt  DateTime?
  /// A new address waiting to be verified. contactEmail stays in use until then.
  pendingEmail     String?
  /// Raised when the password is reset or changed, which signs out every other session.
  sessionVersion   Int       @default(0)
  /// Set when someone without a verified email asks for a password reset (the Founder sees it).
  resetRequestedAt DateTime?
  tokens           AuthToken[]
  /// Set for people who signed up through a team invitation link. They can't sign in until their email is verified.
  joinedViaId      String?
  joinedVia        TeamInvite?  @relation("JoinedVia", fields: [joinedViaId], references: [id], onDelete: SetNull)
  invitesCreated   TeamInvite[] @relation("InviteCreator")
  name         String
  /// FOUNDER | HEAD | MEMBER
  role         String  @default("MEMBER")
  position     String  @default("")
  bio          String  @default("")
  professional String  @default("")
  phone        String  @default("")
  linkedin     String  @default("")
  /// Profile picture is stored as an external link, not an uploaded file.
  avatarUrl    String  @default("")
  showContact  Boolean @default(true)
  active       Boolean @default(true)

  /// Confidential access is granted explicitly, never by department membership.
  canViewFinance Boolean @default(false)
  canViewHR      Boolean @default(false)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  createdAt DateTime @default(now())

  attendance          Attendance[]   @relation("AttendanceMember")
  attendanceRecorded  Attendance[]   @relation("AttendanceRecorder")
  kpisUpdated         Kpi[]
  reports             WeeklyReport[] @relation("ReportAuthor")
  reportsReviewed     WeeklyReport[] @relation("ReportReviewer")
  evaluations         Evaluation[]   @relation("EvaluationSubject")
  evaluationsWritten  Evaluation[]   @relation("EvaluationAuthor")
  hqRecordsUpdated    HqRecord[]
}

/// A shareable sign-up link created by the Founder (Settings → Team invitations).
/// Anyone with the link can create an account in the chosen department and role, after verifying their email.
model TeamInvite {
  id          String    @id @default(cuid())
  /// Random code in the link: /join/<code>
  code        String    @unique
  /// Department joiners are placed in. Null = the person chooses one.
  teamId      String?
  team        Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  /// HEAD | MEMBER
  role        String    @default("MEMBER")
  /// Null = any number of people.
  maxUses     Int?
  uses        Int       @default(0)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdById String
  createdBy   User      @relation("InviteCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  members     User[]    @relation("JoinedVia")
}

/// Single-use links sent by email. Only a hash of the token is stored.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// INVITE (first password) | RESET (forgot password) | VERIFY_EMAIL (change of email)
  kind      String
  tokenHash String    @unique
  /// The address the link was sent to; for VERIFY_EMAIL, the address being verified.
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, kind])
}

model Attendance {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("AttendanceMember", fields: [userId], references: [id], onDelete: Cascade)
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id])
  /// YYYY-MM-DD
  date         String
  session      String
  /// PRESENT | ABSENT | LATE | EXCUSED
  status       String
  remarks      String   @default("")
  recordedById String
  recordedBy   User     @relation("AttendanceRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())

  @@unique([userId, date, session])
  @@index([teamId, date])
}

/// Weekly KPI matrix row. Measures performance — never a task assignment.
model Kpi {
  id          String   @id @default(cuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])
  name        String
  description String   @default("")
  target      Float
  unit        String   @default("")
  /// ISO week, e.g. 2026-W44
  period      String
  actual      Float?
  remarks     String   @default("")
  updatedById String
  updatedBy   User     @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([teamId, period])
}

model WeeklyReport {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation("ReportAuthor", fields: [userId], references: [id], onDelete: Cascade)
  teamId        String
  team          Team      @relation(fields: [teamId], references: [id])
  period        String
  kpiResults    String    @default("")
  contributions String    @default("")
  challenges    String    @default("")
  remarks       String    @default("")
  /// Newline-separated external URLs
  links         String    @default("")
  /// SUBMITTED | REVIEWED
  status        String    @default("SUBMITTED")
  reviewedById  String?
  reviewedBy    User?     @relation("ReportReviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, period])
  @@index([teamId, period])
}

/// Qualitative monthly evaluation. No combined/weighted score is stored or generated
/// (a formula must first be approved by Projexa Hub — PRD §5.9).
model Evaluation {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("EvaluationSubject", fields: [userId], references: [id], onDelete: Cascade)
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id])
  /// YYYY-MM
  month        String
  attendance   String   @default("")
  kpi          String   @default("")
  reporting    String   @default("")
  contributions String  @default("")
  strengths    String   @default("")
  improvements String   @default("")
  remarks      String   @default("")
  evaluatorId  String
  evaluator    User     @relation("EvaluationAuthor", fields: [evaluatorId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, month])
}

/// A row in one of the fixed, developer-defined HQ section tables
/// (see src/lib/hq-config.ts). `data` is JSON validated against that section's fields.
model HqRecord {
  id          String   @id @default(cuid())
  space       String
  section     String
  data        String
  updatedById String
  updatedBy   User     @relation(fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([space, section])
}
