# PostgreSQL connection string, e.g. from Neon (https://neon.tech).
# Use the "pooled" connection string and keep ?sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Long random string used to sign sign-in sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use a different value in production than locally.
AUTH_SECRET="replace-with-a-long-random-string"
